{
  "name": "@modular-mcp/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "breaking:check": "node ../../scripts/contracts-breaking-check.mjs",
    "build": "tsc --build tsconfig.json",
    "generate:types": "node ../../scripts/contracts-generate-types.mjs --write",
    "lint:schemas": "node ../../scripts/contracts-lint-schemas.mjs",
    "test:contract": "pnpm lint:schemas && pnpm validate:examples && node ../../scripts/contracts-generate-types.mjs && pnpm breaking:check",
    "validate:examples": "node ../../scripts/contracts-validate-examples.mjs"
  }
}
