{
  "name": "@modular-mcp/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "breaking:check": "node ../../scripts/contracts-breaking-check.mjs",
    "build": "tsc --build tsconfig.json",
    "generate:types": "node ../../scripts/contracts-generate-types.mjs --write && node scripts/generate-registry-types.mjs --write",
    "lint:schemas": "node ../../scripts/contracts-lint-schemas.mjs && pnpm validate:registry && node scripts/generate-registry-types.mjs",
    "test:contract": "node ../../scripts/contract-check.mjs",
    "validate:examples": "node ../../scripts/contracts-validate-examples.mjs",
    "validate:registry": "node scripts/validate-registry.mjs"
  }
}
