{
  "name": "@modular-mcp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --build tsconfig.json && node scripts/copy-assets.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --quiet --output-dir /tmp/modular-mcp-wp14b-storybook",
    "install:visual-browser": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "@types/jsdom": "30.0.0",
    "axe-core": "4.13.0",
    "jsdom": "30.1.0",
    "pngjs": "7.0.0",
    "storybook": "10.6.0"
  }
}
