{
  "name": "modular-mcp-suite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "ci:cache-key": "node scripts/lockfile-cache-key.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "dependency:scan": "node scripts/dependency-scan.mjs",
    "lint": "node scripts/lint-workspace.mjs",
    "format": "prettier --check README.md AGENTS.md .secret-scan-allowlist.json .github/**/*.yml package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.packages.json vitest.config.ts \"apps/**/*.{json,ts}\" \"packages/**/*.{json,ts}\" \"infra/**/*.{md,yaml}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "typecheck": "tsc --build tsconfig.packages.json",
    "test": "vitest run",
    "test:contract": "node scripts/contract-check.mjs",
    "test:unit": "vitest run",
    "secret:scan": "node scripts/secret-scan.mjs",
    "build": "pnpm -r --if-present build",
    "infra:up": "scripts/infra.sh up",
    "infra:down": "scripts/infra.sh down",
    "infra:reset": "scripts/infra.sh reset",
    "infra:status": "scripts/infra.sh status",
    "infra:smoke": "scripts/infra.sh smoke",
    "verify:affected": "pnpm ci:local",
    "verify": "pnpm verify:affected"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
